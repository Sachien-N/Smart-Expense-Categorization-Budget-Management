# ============================================================
# Person A - Smart Expense Categorization & Budget Management
# Copy this file to `.env` and adjust values. NEVER commit the
# real `.env` file. This file contains PLACEHOLDERS ONLY.
# ============================================================

# --- Service identity ---
SERVICE_NAME=expense-budget-api
APP_PORT=8001

# --- Database (local SQLite; each project uses its OWN file) ---
# Relative sqlite paths resolve against this project folder (any OS).
DATABASE_URL=sqlite:///data/expense_budget.db
# PostgreSQL (e.g. Render Postgres; postgres:// is accepted and normalized):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Frontend (Streamlit) ---
API_BASE_URL=http://127.0.0.1:8001

# --- Integration endpoints (REAL HTTP REST calls only; A never
#     touches B's or C's databases). Base URLs, no trailing slash needed.
#     The older names INTEGRATION_B_BASE_URL / INTEGRATION_C_BASE_URL are
#     still accepted when these are unset.
SUBSCRIPTION_API_URL=http://127.0.0.1:8002
ELECTRICITY_API_URL=http://127.0.0.1:8003

# --- Outbound integration behaviour ---
# Read timeout: use ~60 when the peers run on free Render instances (cold start).
INTEGRATION_CONNECT_TIMEOUT_SECONDS=3.0
INTEGRATION_TIMEOUT_SECONDS=10.0
INTEGRATION_MAX_RETRIES=2
INTEGRATION_RETRY_BACKOFF_SECONDS=0.5

# --- Frontend HTTP read timeout (seconds) ---
API_TIMEOUT_SECONDS=60
