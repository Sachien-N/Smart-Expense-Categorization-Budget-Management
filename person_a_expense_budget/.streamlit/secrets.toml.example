# Streamlit secrets for the person_a_expense_budget frontend.
#
# Local: copy to .streamlit/secrets.toml (gitignored) - or just set the
#        API_URL / API_SECRET environment variables, which take precedence.
# Streamlit Community Cloud: App settings -> Secrets -> paste the block below.
#
# API_URL       : Google Apps Script Web App /exec URL (the spreadsheet's data API).
# API_SECRET    : the SAME secret that is stored in the Apps Script project's
#                 Script Properties (key: API_SECRET). Never commit the real value;
#                 rotate it immediately if it is ever shared in chat/screenshots.
# BACKEND_API_URL: Person A's FastAPI backend on Render - powers the live
#                 Integrations page (status + sync + Sheets mirroring).
API_URL = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
API_SECRET = "replace-with-a-rotated-secret-do-not-commit"
BACKEND_API_URL = "https://smart-expense-categorization-budget.onrender.com"

# Optional local fallback when API_URL is not set (runs against a local backend):
# API_BASE_URL = "http://127.0.0.1:8001"
