# Streamlit secrets for the person_a_expense_budget frontend.
#
# Local: copy to .streamlit/secrets.toml (gitignored) - or just set the
#        API_BASE_URL environment variable, which takes precedence.
# Streamlit Community Cloud: App settings -> Secrets -> paste the line below
#        with this project's deployed Render backend URL.
API_BASE_URL = "http://127.0.0.1:8001"
